# Modèle de configuration locale. Copie ce fichier en `.env` (gitignoré) et
# remplis les valeurs. Sert à propager les secrets shinyapps.io vers le repo
# GitHub via scripts/set_shinyapps_secrets.sh.
#
#   cp .env.example .env && chmod 600 .env   # puis éditer .env
#
# Les 3 secrets sont ceux du compte shinyapps.io (Account → Tokens). Ils sont
# partagés avec les autres simulateurs (paie, pension) : mêmes valeurs.

SHINYAPPS_ACCOUNT=benjello
SHINYAPPS_TOKEN=
SHINYAPPS_SECRET=
